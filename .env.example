# Copy to .env and fill in. Never commit .env.

# Which provider serves the open-weight model: "gemini" or "openai_compatible"
MODEL_PROVIDER=gemini

# --- gemini: Gemma 4 via the Gemini API ---
GEMINI_API_KEY=
# Exact Gemma 4 model id from the Google AI Studio model list (do not guess).
# Seen on the API in Oct 2026: gemma-4-31b-it (dense, best quality), gemma-4-26b-a4b-it (MoE, faster)
MODEL_ID=gemma-4-31b-it
# Second open-weight model, used only when MODEL_ID keeps failing (logged in the run report)
FALLBACK_MODEL_ID=gemma-4-26b-a4b-it

# --- openai_compatible: any OpenAI-style endpoint serving an open-weight model ---
# Ollama locally, or a DigitalOcean GPU Droplet
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=gemma4:e4b

# --- embeddings: open model, runs locally via sentence-transformers ---
EMBED_MODEL=all-MiniLM-L6-v2
